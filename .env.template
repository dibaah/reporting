# Copy to .env and fill in. Never commit .env.

# Runtime user (limited rights: read/write data, no schema changes)
DATABASE_URL=postgresql+psycopg://report_app:CHANGE_ME@localhost:5432/report_intel

# Owner user, used ONLY by migrations (Alembic)
MIGRATION_DATABASE_URL=postgresql+psycopg://report_owner:CHANGE_ME@localhost:5432/report_intel

# Where original report files are stored (outside the repo)
RAW_STORE_PATH=D:\report_intel\raw_store

# Logs
LOG_DIR=D:\report_intel\logs

# Used in later phases (leave empty for now)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TEAMS_WEBHOOK_URL=
